# Pre-push hook — keeps the museum's invariants intact without blocking
# the push on heavy local work that CI / Vercel already does.
#
# Two checks land here:
#
#   1. Submodule HEADs are pushed upstream. The museum's submodule
#      pointers point at SHAs; if any submodule has unpushed commits,
#      another developer cloning the museum at this point would fail
#      to hydrate the submodules. Fast, no node processes spawned.
#
#   2. If projects.tsx changed AND that change touched a banner-
#      relevant field (enhanced/enhancedExternal/reimagined/
#      reimaginedExternal presence flips on any project), run
#      sync:source-meta to push the new CTA to the affected source
#      repos. Gated to that narrow field set so docstring tweaks,
#      comment edits, or schema additions that don't change tier
#      presence don't spawn a sync run that hits the GitHub API for
#      every converted slug.
#
# Notably ABSENT here, by design: `pnpm build`. The build runs in CI
# (Vercel preview deployments) and locally before merge. Spawning the
# full Next.js Turbopack build from a pre-push hook on Windows leaks
# worker processes when the hook fails downstream (e.g. submodule
# check exits non-zero AFTER the build started spawning workers).
# Observed in the wild: hundreds of orphan node.exe processes
# consuming many GB of RAM accumulated across aborted pushes.
# Trust CI for build verification.

# ── Check 1: submodule HEADs ──────────────────────────────────────
git submodule foreach --quiet '
  upstream=$(git rev-parse --abbrev-ref --symbolic-full-name @{upstream} 2>/dev/null || true)
  if [ -z "$upstream" ]; then
    echo "submodule $name has no upstream tracking — checkout the museum-ready branch and set tracking"
    exit 1
  fi
  if ! git merge-base --is-ancestor HEAD "$upstream" 2>/dev/null; then
    echo "submodule $name HEAD is not pushed to $upstream"
    echo "  cd .sources/$name && git push origin HEAD"
    exit 1
  fi
'

# ── Check 2: banner auto-sync (gated tightly) ─────────────────────
#
# Only fires when projects.tsx is in the diff AND the diff touched a
# banner-relevant token. The token list intentionally narrow:
#   - `enhanced:`   field set / removed / changed
#   - `reimagined:` field set / removed / changed
#   - `enhancedExternal:` / `reimaginedExternal:` URL fields
#   - `COMING_SOON` placeholder usage (going from real impl → coming
#     soon or vice versa flips banner CTA visibility)
#
# Cosmetic edits to projects.tsx (docstring tweaks, prose in notes,
# tech array reordering) won't match the regex and skip the sync —
# the previous gate ran sync on EVERY projects.tsx touch, which is
# expensive when projects.tsx is in the diff for unrelated reasons.
#
# Use git diff against the upstream ref. If no upstream tracking
# (first push of a branch), skip the auto-sync — there's no baseline
# to diff against. Manual `pnpm sync:source-meta` is always available.
upstream=$(git rev-parse --abbrev-ref --symbolic-full-name @{upstream} 2>/dev/null || true)
if [ -n "$upstream" ]; then
  banner_relevant_diff=$(git diff "$upstream..HEAD" -- src/lib/projects.tsx 2>/dev/null | grep -E '^[+-].*(enhanced:|reimagined:|enhancedExternal:|reimaginedExternal:|COMING_SOON)' || true)
  if [ -n "$banner_relevant_diff" ]; then
    echo "pre-push: banner-relevant change in projects.tsx — running pnpm sync:source-meta"
    pre_sync_index=$(git write-tree)
    pnpm sync:source-meta
    post_sync_index=$(git write-tree)
    if [ "$pre_sync_index" != "$post_sync_index" ]; then
      echo ""
      echo "pre-push: sync:source-meta produced submodule-pointer bumps."
      echo "         Review the staged changes, commit them, and push again."
      echo ""
      git status --short
      exit 1
    fi
  fi
fi
