{
  "name": "unlv-museum",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prepare": "husky",
    "postinstall": "git submodule update --init --recursive 2>/dev/null || true && git config push.recurseSubmodules check 2>/dev/null || true",
    "sync:source": "tsx scripts/sync-source.ts",
    "sync:source-meta": "tsx scripts/sync-source-meta.ts",
    "seed:admin-portal": "tsx --env-file=.env.local scripts/seed-admin-portal.ts",
    "verify:locks": "tsx scripts/verify-locks.ts",
    "banners:update-index": "tsx scripts/banner-experiments/update-index.mts",
    "banners:update-index-v2": "tsx scripts/banner-experiments-v2/update-index.mts",
    "banners:update-index-v3": "tsx scripts/banner-experiments-v3/update-index.mts",
    "banners:update-index-verified": "tsx scripts/verified-banner-experiments/update-index.mts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "simple-icons": "^16.20.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md}": "prettier --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core",
      "sharp"
    ]
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.7.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3"
  }
}
